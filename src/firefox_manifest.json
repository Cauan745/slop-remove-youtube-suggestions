{
  "name": "Slop RYS — Unofficial Fork",
  "description": "An unofficial fork of Remove YouTube Suggestions that keeps features free and local.",
  "homepage_url": "https://github.com/Cauan745/slop-remove-youtube-suggestions",
  "manifest_version": 2,
  "version": "4.6.0",

  "icons": {
    "16": "/images/16.png",
    "32": "/images/32.png",
    "64": "/images/64.png",
    "128": "/images/128.png"
  },

  "background": {
    "scripts": [
      "/background/events.js"
    ],
    "persistent": false
  },

  "content_scripts": [
    {
      "js": [
        "/shared/main.js",
        "/shared/utils.js",
        "/shared/banners.js",
        "/shared/youtube-translation.js",
        "/content-script/youtube-translation.js",
        "/content-script/main.js"
      ],
      "css": ["/content-script/main.css"],
      "all_frames": true,
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://www.youtube-nocookie.com/*",
        "*://m.youtube-nocookie.com/*"],
      "run_at": "document_start"
    }
  ],

  "browser_action": {
    "default_popup": "/options/main.html",
    "default_title": "Slop RYS",
    "default_icon": {
      "16": "/images/16.png",
      "32": "/images/32.png",
      "64": "/images/64.png",
      "128": "/images/128.png"
    }
  },

  "options_ui": {
    "page": "/options/main.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "https://www.googleapis.com/youtube/v3/*"
  ],
  "web_accessible_resources": [
    "/images/rys.svg",
    "/content-script/translation-page.js"
  ]
}
